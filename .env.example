# KATIE Guard — example environment. Copy to server/.env or repo-root .env.
# No real values here, no keys. The demo runs with all defaults and no
# secrets: signing is offline-only with an ephemeral in-memory keypair.

# Testnet only. Any other value refuses to start. Never mainnet.
NEAR_NETWORK=testnet

# Testnet JSON-RPC endpoint. Change this if your network blocks the
# default; any NEAR testnet JSON-RPC endpoint works. If the endpoint is
# unreachable, checks honestly report "RPC unavailable — local evidence
# only" and the demo still runs.
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Reserved and UNUSED: broadcast is not implemented in this prototype.
# Any value leaves the server offline-sign only. No tokens ever move.
NEAR_BROADCAST=false

# Demo identities named in offline-signed transactions. No contract is
# deployed at the contract id and nothing is broadcast, so these are
# labelled demo targets only — not real accounts under our control.
NEAR_DEMO_SIGNER=guard-demo-signer.testnet
NEAR_DEMO_CONTRACT=guard-demo.testnet

PORT=3000
